<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="24sp"/>

        <!-- Account Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/settings_account"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_card_surface"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include android:id="@+id/settings_edit_profile"
                layout="@layout/item_settings_row"/>
            <include android:id="@+id/settings_privacy"
                layout="@layout/item_settings_row"/>
            <include android:id="@+id/settings_notifications_pref"
                layout="@layout/item_settings_row"/>
        </LinearLayout>

        <!-- Appearance Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/settings_appearance"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_card_surface"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include android:id="@+id/settings_theme"
                layout="@layout/item_settings_row"/>
            <include android:id="@+id/settings_language"
                layout="@layout/item_settings_row"/>
        </LinearLayout>

        <!-- About Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/settings_about"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_card_surface"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include android:id="@+id/settings_help"
                layout="@layout/item_settings_row"/>
            <include android:id="@+id/settings_terms"
                layout="@layout/item_settings_row"/>
            <include android:id="@+id/settings_version"
                layout="@layout/item_settings_row"/>
        </LinearLayout>

        <!-- Logout -->
        <TextView
            android:id="@+id/settings_logout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/shape_card_surface"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/settings_logout"
            android:textColor="@color/color_error"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="@string/settings_version_value"
            android:textColor="@color/color_text_hint"
            android:textSize="12sp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
