<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/friends_title"
            android:textColor="@color/white"
            android:textSize="24sp"/>

        <ImageView
            android:id="@+id/friends_add_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_person_add"
            app:tint="@color/color_primary_start"/>

        <ImageView
            android:id="@+id/friends_search_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/white"/>
    </LinearLayout>

    <!-- Search bar (initially gone) -->
    <EditText
        android:id="@+id/friends_search_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_input_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="@color/color_text_hint"
        android:fontFamily="@font/poppins"
        android:hint="@string/friends_search_hint"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/color_text_hint"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- Tabs: Amigos / Solicitudes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_segmented_control"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/friends_tab_all"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/shape_segmented_active"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/friends_tab_all"
            android:textColor="@color/white"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/friends_tab_requests"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/friends_tab_requests"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/friends_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="100dp"/>

</LinearLayout>
