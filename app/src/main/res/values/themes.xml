<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ALEA" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#FF8C42</item>
        <item name="colorPrimaryVariant">#FF4B6A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4E54C8</item>
        <item name="colorSecondaryVariant">#8F94FB</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorError">@color/color_error</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="Theme.ALEA.Splash" parent="Theme.ALEA">
        <item name="android:windowBackground">@color/color_background</item>
    </style>

    <style name="Theme.ALEA.FullScreen" parent="Theme.ALEA">
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.Alea.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/shape_dialog_bg</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Theme.Alea.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Alea.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Alea.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.Alea.Dialog.Button.Negative</item>
        <item name="colorControlActivated">@color/color_primary_start</item>
        <item name="colorAccent">@color/color_primary_start</item>
    </style>

    <style name="Theme.Alea.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <style name="Theme.Alea.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/color_primary_start</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/color_primary_start</item>
    </style>

    <style name="Theme.Alea.Dialog.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
